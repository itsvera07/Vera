# Neon Postgres connection string — IMPORTANT: use the "Pooled connection"
# string from your Neon dashboard (hostname contains "-pooler"), not the
# direct one. The direct connection is meant for migrations/admin tools and
# is noticeably slower for a web app's normal request traffic.
DATABASE_URI=postgresql://user:password@host-pooler/dbname?sslmode=require

# Long random string used to sign Payload's auth cookies/tokens
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of this deployed app (used for CMS live-preview + email links)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Supabase Storage (media storage — free tier at supabase.com)
# Find these under Project Settings -> Data API -> S3 Connection, after
# creating a Storage bucket named "vera-media" (Storage -> New bucket).
SUPABASE_STORAGE_BUCKET=vera-media
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Razorpay (wallet top-ups)
# Get RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET from Razorpay Dashboard ->
# Settings -> API Keys. Start with TEST mode keys until you're ready to
# accept real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended once deployed: Dashboard -> Settings -> Webhooks
# -> add an endpoint at https://yourdomain.com/api/custom/razorpay-webhook
# subscribed to the "payment.captured" event, then paste its secret here.
RAZORPAY_WEBHOOK_SECRET=
